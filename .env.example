# Never commit .env.local or firebase-applet-config.json to a public repository.

# Firebase Web App Configuration (set in Vercel / Netlify / .env.local)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
