rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'mdrimon01889@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isValidPlatform(p) {
      return p is string && p in ['Android', 'Windows', 'macOS', 'Linux', 'Cross-Platform', 'Web'];
    }

    function isValidUrlOrEmpty(u, maxLen) {
      return u is string
        && u.size() <= maxLen
        && (u.size() == 0 || u.matches('^https://.*') || u.matches('^/src/assets/images/.*'));
    }

    function isValidHighlightItem(item) {
      return item is string && item.size() >= 1 && item.size() <= 120;
    }

    function isValidHighlights(list) {
      return list is list
        && list.size() <= 6
        && (list.size() < 1 || isValidHighlightItem(list[0]))
        && (list.size() < 2 || isValidHighlightItem(list[1]))
        && (list.size() < 3 || isValidHighlightItem(list[2]))
        && (list.size() < 4 || isValidHighlightItem(list[3]))
        && (list.size() < 5 || isValidHighlightItem(list[4]))
        && (list.size() < 6 || isValidHighlightItem(list[5]));
    }

    // --- Validation Blueprints ---
    function isValidShowcaseApp(data) {
      return data.keys().hasAll([
          'name', 'tagline', 'description', 'platform', 'category',
          'githubRepo', 'directDownloadUrl', 'assetKeyword', 'version',
          'fileSize', 'coverImage', 'highlights', 'featured', 'isPublished',
          'sortOrder', 'ownerId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'name', 'tagline', 'description', 'platform', 'category',
          'githubRepo', 'directDownloadUrl', 'assetKeyword', 'version',
          'fileSize', 'coverImage', 'highlights', 'featured', 'isPublished',
          'sortOrder', 'ownerId', 'createdAt', 'updatedAt'
        ])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.tagline is string && data.tagline.size() >= 1 && data.tagline.size() <= 160
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 2000
        && isValidPlatform(data.platform)
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 40
        && data.githubRepo is string && data.githubRepo.size() >= 3 && data.githubRepo.size() <= 120
        && data.githubRepo.matches('^[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+$')
        && isValidUrlOrEmpty(data.directDownloadUrl, 500)
        && data.assetKeyword is string && data.assetKeyword.size() <= 40
        && data.version is string && data.version.size() >= 1 && data.version.size() <= 32
        && data.fileSize is string && data.fileSize.size() <= 32
        && isValidUrlOrEmpty(data.coverImage, 500)
        && isValidHighlights(data.highlights)
        && data.featured is bool
        && data.isPublished is bool
        && data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 10000
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudioSettings(data) {
      return data.keys().hasAll([
          'studioName', 'heroKicker', 'heroHeadline', 'heroSubtext',
          'githubUsername', 'aboutText', 'contactUrl', 'ownerId', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'studioName', 'heroKicker', 'heroHeadline', 'heroSubtext',
          'githubUsername', 'aboutText', 'contactUrl', 'ownerId', 'updatedAt'
        ])
        && data.studioName is string && data.studioName.size() >= 1 && data.studioName.size() <= 60
        && data.heroKicker is string && data.heroKicker.size() >= 1 && data.heroKicker.size() <= 60
        && data.heroHeadline is string && data.heroHeadline.size() >= 1 && data.heroHeadline.size() <= 140
        && data.heroSubtext is string && data.heroSubtext.size() >= 1 && data.heroSubtext.size() <= 320
        && data.githubUsername is string && data.githubUsername.size() <= 60
        && data.aboutText is string && data.aboutText.size() <= 1200
        && data.contactUrl is string && data.contactUrl.size() <= 200
        && (data.contactUrl.size() == 0 || data.contactUrl.matches('^https://.*') || data.contactUrl.matches('^mailto:.*'))
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.updatedAt is timestamp;
    }

    // --- Collection: /apps/{appId} ---
    match /apps/{appId} {
      allow get: if isValidId(appId) && ((resource != null && resource.data.isPublished == true) || isAdmin());
      allow list: if resource.data.isPublished == true || isAdmin();

      allow create: if isAdmin()
        && isValidId(appId)
        && isValidShowcaseApp(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(appId)
        && isValidShowcaseApp(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Edit full app details
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'tagline', 'description', 'platform', 'category',
            'githubRepo', 'directDownloadUrl', 'assetKeyword', 'version',
            'fileSize', 'coverImage', 'highlights', 'featured', 'isPublished',
            'sortOrder', 'updatedAt'
          ]) ||
          // Action: Quick toggle visibility or featured state
          incoming().diff(existing()).affectedKeys().hasOnly(['featured', 'isPublished', 'updatedAt'])
        );

      allow delete: if isAdmin() && isValidId(appId);
    }

    // --- Collection: /settings/{settingId} ---
    match /settings/{settingId} {
      allow get: if isValidId(settingId) && settingId == 'studio';
      allow list: if false;

      allow create: if isAdmin()
        && isValidId(settingId)
        && settingId == 'studio'
        && isValidStudioSettings(incoming())
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(settingId)
        && settingId == 'studio'
        && isValidStudioSettings(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'studioName', 'heroKicker', 'heroHeadline', 'heroSubtext',
          'githubUsername', 'aboutText', 'contactUrl', 'updatedAt'
        ]);

      allow delete: if false;
    }
  }
}
