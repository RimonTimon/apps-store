{
  "entities": {
    "ShowcaseApp": {
      "title": "ShowcaseApp",
      "description": "An application showcased on Apps by Rimon with direct GitHub Releases download.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Display name of the application.",
          "minLength": 1,
          "maxLength": 80
        },
        "tagline": {
          "type": "string",
          "description": "Short summary of the application.",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the application.",
          "minLength": 1,
          "maxLength": 2000
        },
        "platform": {
          "type": "string",
          "description": "Target platform.",
          "enum": ["Android", "Windows", "macOS", "Linux", "Cross-Platform", "Web"]
        },
        "category": {
          "type": "string",
          "description": "Functional category.",
          "minLength": 1,
          "maxLength": 40
        },
        "githubRepo": {
          "type": "string",
          "description": "GitHub repository in owner/repo format.",
          "minLength": 3,
          "maxLength": 120,
          "pattern": "^[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+$"
        },
        "directDownloadUrl": {
          "type": "string",
          "description": "Optional explicit GitHub release asset URL.",
          "minLength": 0,
          "maxLength": 500
        },
        "assetKeyword": {
          "type": "string",
          "description": "Optional file extension matcher.",
          "minLength": 0,
          "maxLength": 40
        },
        "version": {
          "type": "string",
          "description": "Version label.",
          "minLength": 1,
          "maxLength": 32
        },
        "fileSize": {
          "type": "string",
          "description": "Formatted file size.",
          "minLength": 0,
          "maxLength": 32
        },
        "coverImage": {
          "type": "string",
          "description": "App icon path or HTTPS URL.",
          "minLength": 0,
          "maxLength": 500
        },
        "highlights": {
          "type": "array",
          "description": "Up to 6 short feature highlights."
        },
        "featured": {
          "type": "boolean",
          "description": "Featured flag."
        },
        "isPublished": {
          "type": "boolean",
          "description": "Public visibility flag."
        },
        "sortOrder": {
          "type": "number",
          "description": "Display ordering index."
        },
        "ownerId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "name",
        "tagline",
        "description",
        "platform",
        "category",
        "githubRepo",
        "directDownloadUrl",
        "assetKeyword",
        "version",
        "fileSize",
        "coverImage",
        "highlights",
        "featured",
        "isPublished",
        "sortOrder",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/apps/{appId}": {
      "schema": {
        "$ref": "#/entities/ShowcaseApp"
      },
      "description": "Publicly readable published apps; all writes restricted strictly to verified admin mdrimon01889@gmail.com."
    }
  }
}
